<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Sanrucho - Contacto</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Quicksand:wght@500;700&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="{{ url_for('static', filename='css/estilos.css') }}">
</head>
<body class="contacto-body">

    <section class="problema-hero-contacto">
        <div class="container hero-content">
            <div class="row align-items-center justify-content-center text-center text-lg-start g-4">
                
                <div class="col-12 col-lg-7">
                    <div class="badge-sugerencia">
                        <i class="fa-solid fa-heart text-danger"></i> Buzón de Mensajes & Soporte
                    </div>
                    <h1 class="titulo-contacto">¿Tienes algún problema o sugerencia?</h1>
                    <p class="subtitulo-contacto">
                        Cuéntanos qué pasó o qué te gustaría ver en la web. <br class="d-none d-sm-inline"> ¡Estaremos felices de leerte! ✨
                    </p>
                </div>

                <div class="col-12 col-lg-5 text-center">
                    <div class="mascota-wrapper">
                        <img src="{{ url_for('static', filename='img/sanrio-contacto.png') }}" alt="Mascota de contacto" class="img-banner img-fluid">
                    </div>
                </div>

            </div>
        </div>
    </section>

    <main class="contacto-container my-5">
        <div class="row align-items-center justify-content-center g-4">
            
            <!-- Columna izquierda: Imagen decorativa + Texto explicativo -->
            <div class="col-12 col-md-5 text-center">
                <div class="columna-info-contacto">
                    <img class="img-fluid contactanos-img mb-3" src="{{ url_for('static', filename='img/contactanos.png') }}" alt="¡Contáctanos!">
                    <div class="d-block">
                        <p class="contacto-text">
                            Al llenar este formulario, estarás contactándonos a nuestro email.<br>
                            <span>Te responderemos lo antes posible.</span>
                        </p>
                    </div>
                </div>
            </div>

            <!-- Columna derecha: Formulario -->
            <div class="col-12 col-md-7 col-lg-5">
                <div class="formulario-contacto shadow-sm">
                    <form action="#" method="POST" class="needs-validation" novalidate>
                        <div class="mb-3 text-start">
                            <label for="nombre" class="form-label">Nombre</label>
                            <input type="text" class="form-control form-control-custom" id="nombre" name="nombre" placeholder="Tu nombre" required>
                            <div class="invalid-feedback">Por favor, ingresa tu nombre.</div>
                        </div>

                        <div class="mb-3 text-start">
                            <label for="email" class="form-label">Correo electrónico</label>
                            <input type="email" class="form-control form-control-custom" id="email" name="email" placeholder="nombre@correo.com" required>
                            <div class="invalid-feedback">Por favor, ingresa tu correo electrónico.</div>
                        </div>

                        <div class="mb-4 text-start">
                            <label for="mensaje" class="form-label">Mensaje</label>
                            <textarea class="form-control form-control-custom" id="mensaje" name="mensaje" rows="4" placeholder="Escribe aquí tu duda o sugerencia..." required></textarea>
                            <div class="invalid-feedback">Por favor, ingresa un mensaje.</div>
                        </div>

                        <button type="submit" class="btn btn-enviar w-100">
                            <i class="fa-solid fa-paper-plane me-2"></i>Enviar mensaje
                        </button>
                    </form>
                </div>
            </div>

        </div>
    </main>

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="{{ url_for('static', filename='js/validaciones.js') }}"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
</body>
</html>