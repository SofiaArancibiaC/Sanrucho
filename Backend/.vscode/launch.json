{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "java",
      "name": "Debug Eureka",
      "request": "launch",
      "cwd": "${workspaceFolder}/eureka",
      "mainClass": "cl.sanrucho.eureka.TiendaEurekaApplication",
      "projectName": "cl-sanrucho-eureka",
      "envFile": "${workspaceFolder}/.env"
    },
    {
      "type": "java",
      "name": "Debug ms-usuarios",
      "request": "launch",
      "cwd": "${workspaceFolder}/ms-usuarios",
      "mainClass": "cl.sanrucho.usuarios.TiendaUsuariosApplication",
      "projectName": "cl-sanrucho-usuarios",
      "envFile": "${workspaceFolder}/.env"
    },
    {
      "type": "java",
      "name": "Debug ms-catalogo",
      "request": "launch",
      "cwd": "${workspaceFolder}/ms-catalogo",
      "mainClass": "cl.sanrucho.catalogo.TiendaCatalogoApplication",
      "projectName": "cl-sanrucho-catalogo",
      "envFile": "${workspaceFolder}/.env"
    },
    {
      "type": "java",
      "name": "Debug ms-pedidos",
      "request": "launch",
      "cwd": "${workspaceFolder}/ms-pedidos",
      "mainClass": "cl.sanrucho.pedidos.TiendaPedidosApplication",
      "projectName": "cl-sanrucho-pedidos",
      "envFile": "${workspaceFolder}/.env"
    }
  ],
  "compounds": [
    {
      "name": "Debug All Services",
      "configurations": [
        "Debug Eureka",
        "Debug ms-usuarios",
        "Debug ms-catalogo",
        "Debug ms-pedidos"
      ]
    }
  ]
}
